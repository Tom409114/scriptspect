{
  "name": "scriptspect",
  "version": "0.0.0",
  "description": "Static analyzer for package.json scripts - catches shell-specific commands before they break Windows, macOS, or Linux builds.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tom409114/scriptspect.git"
  },
  "bugs": "https://github.com/Tom409114/scriptspect/issues",
  "homepage": "https://github.com/Tom409114/scriptspect#readme",
  "author": "Tom409114",
  "keywords": [
    "cross-platform",
    "windows",
    "static-analysis",
    "npm-scripts",
    "package-json",
    "lint",
    "shellcheck",
    "portability",
    "monorepo"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "scriptspect": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/README.md",
    "docs/rules",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:rules": "tsx tools/gen-rule-docs.ts",
    "schemas:generate": "tsx tools/generate-schemas.ts",
    "schemas:check": "pnpm schemas:generate && git diff --exit-code -- schema"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.17.1",
    "scripts-doctor": "1.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
